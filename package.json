{
  "name": "line-desktop-mcp",
  "version": "1.2.0",
  "description": "macOS LINE Desktop MCP：AI agent 本機文字、圖片與有界歷史整合",
  "main": "./src/server.js",
  "bin": {
    "line-desktop-mcp": "./src/server.js"
  },
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "build:mcpb": "node scripts/build-mcpb.js",
    "setup:mac": "node scripts/setup-mac.mjs --claude",
    "check": "node scripts/check-install.mjs",
    "build:release": "node scripts/build-release.mjs"
  },
  "keywords": [
    "mcp",
    "line",
    "automation",
    "gui",
    "applescript",
    "desktop"
  ],
  "author": "Geoffrey Wang",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.1",
    "applescript": "^1.0.0",
    "archiver": "8.0.0",
    "chardet": "^2.1.0",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "iconv-lite": "^0.6.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "os": [
    "darwin"
  ],
  "files": [
    "src/**/*",
    "scripts/setup-mac.mjs",
    "scripts/check-install.mjs",
    "Install.command",
    "docs/*.md",
    "README.md",
    "LICENSE.md",
    "NOTICE.md",
    "CHANGELOG.md",
    "manifest.json",
    "package-lock.json"
  ],
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/s2339956/line-desktop-mcp.git"
  },
  "homepage": "https://github.com/s2339956/line-desktop-mcp#readme",
  "bugs": {
    "url": "https://github.com/s2339956/line-desktop-mcp/issues"
  },
  "contributors": [
    {
      "name": "s2339956",
      "url": "https://github.com/s2339956"
    }
  ],
  "overrides": {
    "readdir-glob": {
      "minimatch": "11.0.1"
    }
  }
}
