{
  "manifest_version": "0.2",
  "name": "line-desktop-mcp",
  "display_name": "LINE Desktop MCP for macOS",
  "version": "1.6.0",
  "description": "macOS LINE Desktop MCP：AI agent 本機文字、圖片與有界歷史整合",
  "author": {
    "name": "s2339956",
    "url": "https://github.com/s2339956"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/s2339956/line-desktop-mcp.git"
  },
  "homepage": "https://github.com/s2339956/line-desktop-mcp#readme",
  "support": "https://github.com/s2339956/line-desktop-mcp/issues",
  "keywords": [
    "mcp",
    "line",
    "automation",
    "gui",
    "applescript",
    "desktop"
  ],
  "server": {
    "type": "node",
    "entry_point": "src/server.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/src/server.js"
      ]
    }
  },
  "compatibility": {
    "platforms": [
      "darwin"
    ],
    "runtimes": {
      "node": ">=22.0.0"
    }
  },
  "tools_generated": true
}
